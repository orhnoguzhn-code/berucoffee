# Resolve react_native_pods.rb with node to allow for hoisting
    require Pod::Executable.execute_command('node', ['-p',
    'require.resolve(
      "react-native/scripts/react_native_pods.rb",
      {paths: [process.argv[1]]},
    )', __dir__]).strip

    require 'fileutils'

    # Expo bare workflow autolinking.
    require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

    # Expo SDK 57's JSI date helper uses an unqualified abs() call. Xcode's C++
    # interop exposes another abs overload, so qualify Swift's implementation before
    # CocoaPods builds the ExpoModulesJSI xcframework.
    expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
    expo_jsi_date = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift')
    if File.file?(expo_jsi_date)
    source = File.read(expo_jsi_date)
    patched = source.gsub('abs(milliseconds)', 'Swift.abs(milliseconds)')
    File.write(expo_jsi_date, patched) if patched != source
    end

    platform :ios, '16.4'
    ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
    ENV['RCT_USE_RN_DEP'] = '0'
    prepare_react_native_project!
    use_expo_modules!

    # Firebase + RNFB works reliably with static frameworks in this project.
    use_frameworks! :linkage => :static
    $RNFirebaseAsStaticFramework = true
    $FirebaseSDKVersion = '11.7.0'
    $RNMapsAsStaticFramework = true

    # RN 0.86 + Expo 57 currently fails simulator compilation with the new architecture.
    ENV['RCT_NEW_ARCH_ENABLED'] = '0'

    target 'CoffeeLoyalty' do
    config = use_native_modules!

    use_react_native!(
      :path => config[:reactNativePath],
      :new_arch_enabled => false,
      :app_path => "#{Pod::Config.instance.installation_root}/.."
    )

    post_install do |installer|
      react_native_post_install(
        installer,
        config[:reactNativePath],
        :mac_catalyst_enabled => false
      )

      # RN 0.86 source build loses React/DevSupport (RCTDevLoadingViewProtocol.h),
      # React/Inspector and third-party header search paths under use_frameworks!.
      # Restore them with absolute paths resolved at pod-install time.
      rn_abs = ENV['REACT_NATIVE_PATH'] || File.expand_path('../node_modules/react-native', __dir__)
      rn_abs = File.realpath(rn_abs) if File.exist?(rn_abs)
      sandbox_abs = Pod::Config.instance.sandbox_root.to_s

      installer.pods_project.targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
          build_config.build_settings['SWIFT_VERSION'] = '5.0'
          build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          build_config.build_settings['USE_HEADERMAP'] = 'NO'

          # Disable Inspector to avoid missing RCTInspectorDevServerHelper.h in Expo 57
          if target.name.include?('React')
            defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || []
            defs = defs.is_a?(String) ? defs.split(' ') : [defs].flatten
            defs = defs.map(&:to_s).reject { |d| d.start_with?('RCT_ENABLE_INSPECTOR') }
            defs << 'RCT_ENABLE_INSPECTOR=0'
            build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
          end

          # Restore RN header search paths for every React-* target so files
          # like RCTDevLoadingViewProtocol.h (React/DevSupport) resolve.
          if target.name.start_with?('React-') || target.name == 'ReactCommon' ||
             target.name == 'RNReanimated' || target.name == 'RNWorklets'
            abs_paths = [
              "#{rn_abs}/React/DevSupport",
              "#{rn_abs}/React/Inspector",
              "#{rn_abs}/React",
              "#{rn_abs}/ReactCommon",
              "#{rn_abs}/ReactCommon/react/nativemodule/core",
              "#{rn_abs}/ReactCommon/callinvoker",
              "#{rn_abs}/ReactCommon/runtime",
              "#{rn_abs}/ReactCommon/jsitooling",
              File.join(sandbox_abs, 'glog'),
              File.join(sandbox_abs, 'boost'),
              File.join(sandbox_abs, 'DoubleConversion'),
              File.join(sandbox_abs, 'fast_float', 'include'),
              File.join(sandbox_abs, 'fmt', 'include'),
              File.join(sandbox_abs, 'SocketRocket'),
              File.join(sandbox_abs, 'RCT-Folly'),
              File.join(sandbox_abs, 'Headers', 'Public', 'ReactCommon')
            ]
            hsp = build_config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
            quoted = abs_paths.map { |p| "\"#{p}\"" }.join(' ')
            build_config.build_settings['HEADER_SEARCH_PATHS'] = "#{quoted} #{hsp}"
            # Belt and suspenders: same paths on the clang command line.
            flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
            build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
              "#{flags} #{abs_paths.map { |p| "-I\"#{p}\"" }.join(' ')}"
            cflags = build_config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
            build_config.build_settings['OTHER_CFLAGS'] =
              "#{cflags} #{abs_paths.map { |p| "-I\"#{p}\"" }.join(' ')}"
          end
        end
      end
    end
    end