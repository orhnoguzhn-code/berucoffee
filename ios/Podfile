# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

# Expo SDK 57 / Xcode compatibility workaround.
expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
expo_jsi_date = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift')
if File.file?(expo_jsi_date)
  source = File.read(expo_jsi_date)
  patched = source.gsub('abs(milliseconds)', 'Swift.abs(milliseconds)')
  File.write(expo_jsi_date, patched) if patched != source
end

platform :ios, '16.4'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'
prepare_react_native_project!
use_expo_modules!
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true
$FirebaseSDKVersion = '11.7.0'
$RNMapsAsStaticFramework = true
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # React Native 0.86.x + use_frameworks! can make React-Core headers visible
  # both from node_modules and from a generated React framework. Keep
  # React-Core as a static library while Firebase/Expo remain static frameworks.
  pre_install do |installer|
    installer.pod_targets.each do |pod_target|
      if pod_target.name == 'React-Core' || pod_target.name.start_with?('React-Core.')
        pod_target.instance_variable_set(:@build_type, Pod::BuildType.static_library)
      end
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # RCT-Folly workaround: Xcode may expose a partial/incompatible
    # demangle.h. Folly has a cxxabi fallback, so disable only its optional
    # libiberty section at pod-install time.
    folly_demangle = File.join(
      Pod::Config.instance.sandbox_root.to_s,
      'RCT-Folly',
      'folly',
      'Demangle.cpp'
    )
    if File.file?(folly_demangle)
      source = File.read(folly_demangle)
      patched = source.gsub(
        '#if __has_include(<demangle.h>)',
        '#if false && __has_include(<demangle.h>)'
      )
      File.write(folly_demangle, patched) if patched != source
    end

    # React-Core is built as a static library while the Podfile uses static
    # frameworks. In this combination CocoaPods can generate React-Core.common
    # compile settings that do not resolve React Native's DevSupport headers.
    # RCTBridge.mm uses quoted imports, so make those two imports deterministic
    # by converting them to paths relative to React/Base. This avoids depending
    # on generated framework header maps or HEADER_SEARCH_PATHS merging.
    react_native_root = File.expand_path(
      '../node_modules/react-native/React',
      Pod::Config.instance.installation_root
    )
    bridge_file = File.join(react_native_root, 'Base', 'RCTBridge.mm')
    inspector_header = File.join(react_native_root, 'DevSupport', 'RCTInspectorDevServerHelper.h')
    loading_header = File.join(react_native_root, 'DevSupport', 'RCTDevLoadingViewProtocol.h')

    if File.file?(bridge_file)
      source = File.read(bridge_file)
      patched = source
        .gsub('#import "RCTInspectorDevServerHelper.h"', '#import "../DevSupport/RCTInspectorDevServerHelper.h"')
        .gsub('#import "RCTDevLoadingViewProtocol.h"', '#import "../DevSupport/RCTDevLoadingViewProtocol.h"')
      File.write(bridge_file, patched) if patched != source
    else
      raise "React Native RCTBridge.mm not found: #{bridge_file}"
    end

    unless File.file?(inspector_header)
      raise "React Native header not found: #{inspector_header}"
    end
    unless File.file?(loading_header)
      raise "React Native header not found: #{loading_header}"
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

        if target.name == 'React-Core' || target.name.start_with?('React-Core.')
          react_header_dirs = [
            react_native_root,
            File.join(react_native_root, 'Base'),
            File.join(react_native_root, 'DevSupport'),
            File.join(react_native_root, 'Modules'),
            File.join(react_native_root, 'Profiler'),
            File.join(react_native_root, 'RCTBridge'),
            File.join(react_native_root, 'Views'),
            File.join(react_native_root, 'Views', 'ScrollView'),
            File.join(react_native_root, 'Views', 'Text'),
            File.join(react_native_root, 'Views', 'View'),
            File.join(react_native_root, 'Views', 'SafeAreaView')
          ].select { |path| File.directory?(path) }

          existing = build_config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          existing = [existing] unless existing.is_a?(Array)
          existing = existing.flatten
          react_header_dirs.each do |path|
            existing << path unless existing.include?(path)
          end
          build_config.build_settings['HEADER_SEARCH_PATHS'] = existing
        end
      end
    end
  end
end
