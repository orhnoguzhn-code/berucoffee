# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

# Expo SDK 57 / Xcode compatibility workaround.
expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
expo_jsi_date = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift')
if File.file?(expo_jsi_date)
  source = File.read(expo_jsi_date)
  patched = source.gsub('abs(milliseconds)', 'Swift.abs(milliseconds)')
  File.write(expo_jsi_date, patched) if patched != source
end

platform :ios, '16.4'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'
prepare_react_native_project!
use_expo_modules!
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true
$FirebaseSDKVersion = '11.7.0'
$RNMapsAsStaticFramework = true
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    folly_demangle = File.join(
      Pod::Config.instance.sandbox_root.to_s,
      'RCT-Folly',
      'folly',
      'Demangle.cpp'
    )
    if File.file?(folly_demangle)
      source = File.read(folly_demangle)
      patched = source.gsub(
        '#if __has_include(<demangle.h>)',
        '#if false && __has_include(<demangle.h>)'
      )
      File.write(folly_demangle, patched) if patched != source
    end

    # React Native 0.86 with static frameworks has a header-layout mismatch:
    # source files in React/Base and React/DevSupport use basename/relative
    # inspector imports while the generated React module exposes the Cxx
    # inspector header through the React public-header namespace. Keep the
    # source patches narrow; do not add recursive header search paths.
    react_base = File.join(config[:reactNativePath].to_s, 'React', 'Base')
    react_bridge = File.join(react_base, 'RCTBridge.mm')
    if File.file?(react_bridge)
      source = File.read(react_bridge)
      replacements = {
        '#import "RCTInspectorDevServerHelper.h"' => '#import "../DevSupport/RCTInspectorDevServerHelper.h"',
        '#import "RCTDevLoadingViewProtocol.h"' => '#import "../DevSupport/RCTDevLoadingViewProtocol.h"',
        '#import "RCTInspectorNetworkHelper.h"' => '#import "../DevSupport/RCTInspectorNetworkHelper.h"',
        '#import "RCTInspectorUtils.h"' => '#import "../DevSupport/RCTInspectorUtils.h"',
        '#import "RCTPausedInDebuggerOverlayController.h"' => '#import "../DevSupport/RCTPausedInDebuggerOverlayController.h"'
      }
      patched = source.dup
      replacements.each { |from, to| patched = patched.gsub(from, to) }
      File.write(react_bridge, patched) if patched != source
    end

    inspector_helper = File.join(config[:reactNativePath].to_s, 'React', 'DevSupport', 'RCTInspectorDevServerHelper.h')
    if File.file?(inspector_helper)
      source = File.read(inspector_helper)
      patched = source.gsub(
        '#import <React/RCTInspectorPackagerConnection.h>',
        '#import <React/RCTCxxInspectorPackagerConnection.h>'
      ).gsub(
        '#import "../Inspector/RCTInspectorPackagerConnection.h"',
        '#import <React/RCTCxxInspectorPackagerConnection.h>'
      ).gsub(
        '#import "../Inspector/RCTCxxInspectorPackagerConnection.h"',
        '#import <React/RCTCxxInspectorPackagerConnection.h>'
      )
      File.write(inspector_helper, patched) if patched != source
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end
  end
end
