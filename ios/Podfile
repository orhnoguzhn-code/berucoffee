# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

# Expo SDK 57 / Xcode compatibility workaround.
expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
expo_jsi_date = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift')
if File.file?(expo_jsi_date)
  source = File.read(expo_jsi_date)
  patched = source.gsub('abs(milliseconds)', 'Swift.abs(milliseconds)')
  File.write(expo_jsi_date, patched) if patched != source
end

platform :ios, '16.4'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'
prepare_react_native_project!
use_expo_modules!
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true
$FirebaseSDKVersion = '11.7.0'
$RNMapsAsStaticFramework = true
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # RCT-Folly workaround: Xcode may expose a partial/incompatible
    # demangle.h. Folly has a cxxabi fallback, so disable only its optional
    # libiberty section at pod-install time.
    folly_demangle = File.join(
      Pod::Config.instance.sandbox_root.to_s,
      'RCT-Folly',
      'folly',
      'Demangle.cpp'
    )
    if File.file?(folly_demangle)
      source = File.read(folly_demangle)
      patched = source.gsub(
        '#if __has_include(<demangle.h>)',
        '#if false && __has_include(<demangle.h>)'
      )
      File.write(folly_demangle, patched) if patched != source
    end

    # RN 0.86's RCTBridge.mm uses a basename import for this header. In this
    # project React-Core is built as a static framework and the generated
    # framework header search setup does not reliably expose React/DevSupport.
    # Patch only this include to a source-relative path; this is deterministic
    # and avoids restoring the old recursive header-search-path workaround that
    # caused duplicate React framework/source declarations.
    react_bridge = File.join(config[:reactNativePath].to_s, 'React', 'Base', 'RCTBridge.mm')
    if File.file?(react_bridge)
      source = File.read(react_bridge)
      patched = source.gsub(
        '#import "RCTInspectorDevServerHelper.h"',
        '#import "../DevSupport/RCTInspectorDevServerHelper.h"'
      )
      File.write(react_bridge, patched) if patched != source
    end

    # RCTInspectorDevServerHelper.h is under React/DevSupport, while its
    # packager connection header is under React/Inspector. The normal
    # <React/...> module mapping is not available for this static React-Core
    # source compilation, so make this dependency source-relative as well.
    inspector_helper = File.join(config[:reactNativePath].to_s, 'React', 'DevSupport', 'RCTInspectorDevServerHelper.h')
    if File.file?(inspector_helper)
      source = File.read(inspector_helper)
      patched = source.gsub(
        '#import <React/RCTInspectorPackagerConnection.h>',
        '#import "../Inspector/RCTInspectorPackagerConnection.h"'
      )
      File.write(inspector_helper, patched) if patched != source
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end
  end
end
