# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

# Xcode 26 / Swift 6.x compatibility fixes for ExpoModulesJSI 57.
# These are applied to node_modules before CocoaPods generates its build script.
expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
expo_jsi_root = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI')
expo_jsi_cxx = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI-Cxx')

runtime_scheduler = File.join(expo_jsi_cxx, 'include/RuntimeScheduler.h')
if File.file?(runtime_scheduler)
  source = File.read(runtime_scheduler)
  patched = source.gsub(/\bSWIFT_RETURNS_(?:RETAINED|UNRETAINED)\s+/, '')
  File.write(runtime_scheduler, patched) if patched != source
end

# Swift 6.2 (Xcode 26.0-26.3) rejects weak let; weak references must be mutable.
if Dir.exist?(expo_jsi_root)
  Dir.glob(File.join(expo_jsi_root, '**/*.swift')).each do |file|
    source = File.read(file)
    patched = source.gsub(/\bweak let\s+runtime\b/, 'weak var runtime')
    patched = patched.gsub('abs(milliseconds) <= maxJavaScriptDateMilliseconds', 'Swift.abs(milliseconds) <= maxJavaScriptDateMilliseconds')
    File.write(file, patched) if patched != source
  end
end

if File.file?(runtime_scheduler) && File.read(runtime_scheduler).match?(/\bSWIFT_RETURNS_(?:RETAINED|UNRETAINED)\b/)
  abort('ExpoModulesJSI RuntimeScheduler ownership annotations remain after compatibility patch')
end

platform :ios, '16.4'

ENV['RCT_USE_PREBUILT_RNCORE'] = '1'
# Do not set RCT_USE_RN_DEP here. It makes React-RCTAppDelegate resolve from two
# different source locations when Expo autolinking is also enabled.
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

prepare_react_native_project!
use_expo_modules!
use_frameworks! :linkage => :static
# RNFirebase requires this when use_frameworks! is enabled so RNFBApp/RNFBMessaging
# are integrated as static frameworks with their React headers available as modules.
$RNFirebaseAsStaticFramework = true
$FirebaseSDKVersion = '11.7.0'
$RNMapsAsStaticFramework = true

pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('RNFB')
      pod.define_singleton_method(:build_type) do
        Pod::BuildType.static_library
      end
    end
  end
end

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        build_config.build_settings.delete('SWIFT_VERSION')
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
