# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

# Expo SDK 57 / Xcode compatibility workaround.
expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
expo_jsi_date = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI/Coding/JavaScriptCodable+Date.swift')
if File.file?(expo_jsi_date)
  source = File.read(expo_jsi_date)
  patched = source.gsub('abs(milliseconds)', 'Swift.abs(milliseconds)')
  File.write(expo_jsi_date, patched) if patched != source
end

platform :ios, '16.4'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'
prepare_react_native_project!
use_expo_modules!
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true
$FirebaseSDKVersion = '11.7.0'
$RNMapsAsStaticFramework = true
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # React Native 0.86 + use_frameworks! has a known header/module issue.
  # React-Core must be generated as a static library instead of a static
  # framework. Older CocoaPods versions expose PodTarget#build_type only as
  # a reader, so mutate the backing value rather than calling build_type=.
  pre_install do |installer|
    installer.pod_targets.each do |pod_target|
      if pod_target.name == 'React-Core' || pod_target.name == 'React-Core.common'
        pod_target.instance_variable_set(:@build_type, Pod::BuildType.static_library)
      end
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # RCT-Folly workaround: Xcode may expose a partial/incompatible
    # demangle.h. Folly has a cxxabi fallback, so disable only its optional
    # libiberty section at pod-install time.
    folly_demangle = File.join(
      Pod::Config.instance.sandbox_root.to_s,
      'RCT-Folly',
      'folly',
      'Demangle.cpp'
    )
    if File.file?(folly_demangle)
      source = File.read(folly_demangle)
      patched = source.gsub(
        '#if __has_include(<demangle.h>)',
        '#if false && __has_include(<demangle.h>)'
      )
      File.write(folly_demangle, patched) if patched != source
    end

    # React Native 0.86 + use_frameworks! can leave React-Core compiling
    # source files with quoted imports that point to sibling source folders.
    # HEADER_SEARCH_PATHS is not consistently propagated to React-Core.common
    # on all CocoaPods/Xcode combinations, so make these imports unambiguous
    # by resolving them relative to RCTBridge.mm itself. This does not modify
    # the package permanently; CI starts from a fresh node_modules tree.
    react_native_root = File.join(
      Pod::Config.instance.installation_root.to_s,
      '..',
      'node_modules',
      'react-native',
      'React'
    )
    bridge_file = File.join(react_native_root, 'Base', 'RCTBridge.mm')
    if File.file?(bridge_file)
      source = File.read(bridge_file)
      replacements = {
        '#import "RCTInspectorDevServerHelper.h"' => '#import "../DevSupport/RCTInspectorDevServerHelper.h"',
        '#import "RCTDevLoadingViewProtocol.h"' => '#import "../DevSupport/RCTDevLoadingViewProtocol.h"',
        '#import "RCTInspectorNetworkHelper.h"' => '#import "../Inspector/RCTInspectorNetworkHelper.h"',
        '#import "RCTInspectorUtils.h"' => '#import "../Inspector/RCTInspectorUtils.h"',
        '#import "RCTPausedInDebuggerOverlayController.h"' => '#import "../DevSupport/RCTPausedInDebuggerOverlayController.h"'
      }
      patched = source.dup
      replacements.each { |from, to| patched = patched.gsub(from, to) }
      File.write(bridge_file, patched) if patched != source
    end

    # RCTInspectorDevServerHelper.h itself already uses a relative import for
    # the Inspector headers, so it remains independent of Xcode header paths.
    # Keep these paths as a fallback for other React-Core source files.
    react_native_header_paths = [
      File.join(react_native_root, 'Base'),
      File.join(react_native_root, 'DevSupport'),
      File.join(react_native_root, 'Inspector')
    ]

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

        if target.name == 'React-Core' || target.name == 'React-Core.common'
          existing = build_config.build_settings['HEADER_SEARCH_PATHS']
          existing = [existing] if existing.is_a?(String)
          existing = [] if existing.nil?
          build_config.build_settings['HEADER_SEARCH_PATHS'] = existing + react_native_header_paths
        end
      end
    end
  end
end
