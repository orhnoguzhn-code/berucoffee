require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")
require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= podfile_properties['ios.buildReactNativeFromSource'] == 'true' ? '0' : '1'
ENV['RCT_HERMES_V1_ENABLED'] ||= '0' if podfile_properties['expo.useHermesV1'] == 'false'
ENV['EXPO_USE_PRECOMPILED_MODULES'] = '0' if podfile_properties['EXPO_USE_PRECOMPILED_MODULES'] == 'false'
ENV['EXPO_USE_PRECOMPILED_MODULES'] ||= '1'

expo_jsi_package = File.dirname(`node --print "require.resolve('expo-modules-jsi/package.json')"`.strip)
runtime_scheduler = File.join(expo_jsi_package, 'apple/Sources/ExpoModulesJSI-Cxx/include/RuntimeScheduler.h')
if File.file?(runtime_scheduler)
  source = File.read(runtime_scheduler)
  patched = source.gsub(/\bSWIFT_RETURNS_(?:RETAINED|UNRETAINED)\s+/, '')
  File.write(runtime_scheduler, patched) if patched != source
end

camera_kit_package = File.dirname(`node --print "require.resolve('react-native-camera-kit/package.json')"`.strip)
camera_kit_swift_pre = File.join(camera_kit_package, 'ios/ReactNativeCameraKit/ReactNativeCameraKit-Swift.pre.h')
if File.file?(camera_kit_swift_pre)
  source = File.read(camera_kit_swift_pre)
  patched = source.gsub(/#if CK_USE_FRAMEWORKS\n#import <ReactNativeCameraKit\/ReactNativeCameraKit-Swift\.h>\n#else\n#import <ReactNativeCameraKit-Swift\.h>\n#endif/, '#import <ReactNativeCameraKit-Swift.h>')
  File.write(camera_kit_swift_pre, patched) if patched != source
end

platform :ios, podfile_properties['ios.deploymentTarget'] || '16.4'
prepare_react_native_project!

target 'CoffeeLoyalty' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"]
  else
    config_command = ['node', '--no-warnings', '--eval', "require('expo/bin/autolinking')", 'expo-modules-autolinking', 'react-native-config', '--json', '--platform', 'ios']
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']
  use_frameworks! :linkage => :static unless ENV['USE_FRAMEWORKS'] || podfile_properties['ios.useFrameworks']

  $RNFirebaseAsStaticFramework = true
  $FirebaseSDKVersion = '11.7.0'
  $RNMapsAsStaticFramework = true

  # AppDelegate.swift imports GoogleMaps directly. Link the Google Maps SDK
  # itself instead of adding react-native-maps/Google, which conflicts with
  # the autolinked react-native-maps pod source.
  pod 'GoogleMaps'

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if %w[RNFBApp RNFBAuth RNFBMessaging ReactNativeCameraKit GoogleMaps Google-Maps-iOS-Utils].include?(pod.name)
        def pod.build_type
          Pod::BuildType.static_library
        end
      end
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    installer.pods_project.targets.each do |target|
      if target.name == 'ReactNativeCameraKit'
        target.build_configurations.each do |config|
          %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS OTHER_SWIFT_FLAGS].each do |setting|
            value = config.build_settings[setting]
            if value.is_a?(String)
              config.build_settings[setting] = value.gsub('-DCK_USE_FRAMEWORKS=1', '')
            elsif value.is_a?(Array)
              config.build_settings[setting] = value.reject { |flag| flag.to_s == '-DCK_USE_FRAMEWORKS=1' }
            end
          end
        end
      end
    end
  end
end
