# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Required for RNFB pods on RN 0.84+ prebuilt RNCore. See RNFB issue #8930.
ENV['RCT_REMOVE_LEGACY_ARCH'] = '0'

# Expo bare workflow needs this for proper pod autolinking.
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

# Build problematic Expo modules from source to avoid prebuilt xcframework issues
$ExpoUseSources = [
  'expo-modules-jsi',
  'expo',
  'expo-modules-core',
  'expo-constants',
  'expo-asset',
  'expo-file-system',
  'expo-font',
  'expo-keep-awake',
  'expo-linear-gradient',
]

ENV['RCT_NEW_ARCH_ENABLED'] = '1'
# Expo modÃ¼llerini source'dan derle
ENV['EXPO_USE_SOURCE'] = '1'
# Swift explicit modules'Ä± devre dÄ±ÅŸÄ± bÄ±rak
ENV['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'

platform :ios, '16.4'
prepare_react_native_project!
use_expo_modules!

# Required by react-native-firebase v21+ with Firebase iOS SDK 11.x.
# See https://rnfirebase.io/#altering-cocoapods-to-use-frameworks
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# react-native-maps supports use_frameworks! :linkage => :static since v1.6.0.
$RNMapsAsStaticFramework = true

# RNFB pods must be static libraries (not frameworks) to avoid module boundary
# issues with React headers under use_frameworks!. See RNFB issue #8930.
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('RNFB') || pod.name == 'ExpoModulesJSI'
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    minimum_ios_version = '16.4'

    # Remove problematic ExpoModulesJSI xcframework build phase
    installer.pods_project.targets.each do |target|
      if target.name == 'ExpoModulesJSI'
        target.build_phases.each do |phase|
          if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
            if phase.shell_script.include?('Build ExpoModulesJSI xcframework') || 
               phase.shell_script.include?('xcframework')
              puts "ğŸ—‘ï¸  Removing problematic build phase from #{target.name}: #{phase.display_name}"
              target.build_phases.delete(phase)
            end
          end
        end
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        # Swift modularization uyumsuzluÄŸu Ã§Ã¶z
        build_config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        build_config.build_settings['ENABLE_MODULAR_HEADERS'] = 'NO'
        
        # Release konfigÃ¼rasyonu iÃ§in Xcode 16 optimizasyonlarÄ±
        if build_config.name == 'Release'
          build_config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
          build_config.build_settings['GCC_OPTIMIZATION_LEVEL'] = 's'
        end
        
        if target.name.start_with?('RNFB')
          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] unless defs.is_a?(Array)
          defs << 'RCT_REMOVE_LEGACY_ARCH=0' unless defs.include?('RCT_REMOVE_LEGACY_ARCH=0')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++20'
        end
      end
    end

    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        end
      end
    end
  end
end
