# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Build React Native core and dependencies from source. RN 0.86's prebuilt
# React-Core does not expose a Swift-importable React_RCTAppDelegate module,
# so AppDelegate.swift's `import React_RCTAppDelegate` fails with prebuilt RNCore.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
# Third-party deps (glog, boost, folly, fmt, ...) stay PREBUILT: their source
# podspecs have no usable header paths under use_frameworks! (fmt.podspec sets
# none at all). Only RNCore itself must come from source for the
# Swift-importable React_RCTAppDelegate module.
ENV['RCT_USE_RN_DEP'] = '1'

# Required for RNFB pods with RN 0.84+ source RNCore. See RNFB issue #8930.
ENV['RCT_REMOVE_LEGACY_ARCH'] = '0'

# Expo bare workflow needs this for proper pod autolinking.
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), 'scripts/autolinking')

ENV['RCT_NEW_ARCH_ENABLED'] = '1'

platform :ios, '16.4'
prepare_react_native_project!
use_expo_modules!

# Required by react-native-firebase v21+ with Firebase iOS SDK 11.x.
# See https://rnfirebase.io/#altering-cocoapods-to-use-frameworks
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# react-native-maps supports use_frameworks! :linkage => :static since v1.6.0.
$RNMapsAsStaticFramework = true

# RNFB pods must be static libraries (not frameworks) to avoid module boundary
# issues with React headers under use_frameworks!. See RNFB issue #8930.
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('RNFB')
      def pod.build_type
        Pod::BuildType.static_library
      end
    end
  end
end

target 'CoffeeLoyalty' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :new_arch_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    minimum_ios_version = '16.4'

    # Map pod target name -> PodTarget so each target can read its own real
    # header layout (file_accessor, header_mappings_dir, header_dir) instead of
    # guessing; several pods (PromisesObjC, Firebase*) have no CocoaPods header
    # symlink farm under use_frameworks!, so only real source dirs work.
    pod_target_map = {}
    installer.pod_targets.each do |pt|
      pod_target_map[pt.name] = pt
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        build_config.build_settings['SWIFT_VERSION'] = '5.0'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # RN 0.86 source build: React Native pods lose most header search paths
        # under use_frameworks! (React/DevSupport was dropped from React-Core's
        # Default subspec and ReactCommon/third-party paths are not carried over).
        # Compute ABSOLUTE paths (resolved at pod-install time on the build machine)
        # because $(PODS_ROOT)/$(PODS_TARGET_SRCROOT) expansion is unreliable for
        # pod targets on Xcode 26 (see react-native-reanimated#9035, expo#44515).
        # REACT_NATIVE_PATH is set by react_native_pods.rb to the absolute RN
        # root at Podfile-eval time; fall back to a computed path if absent.
        rn_abs = ENV['REACT_NATIVE_PATH'] || File.expand_path(File.join("..", "node_modules", "react-native"), Pod::Config.instance.installation_root.to_s)
        rn_abs = File.realpath(rn_abs) if File.exist?(rn_abs)
        sandbox_abs = Pod::Config.instance.sandbox_root.to_s
        Pod::UI.puts("[berucoffee] RN abs path: #{rn_abs}")
        # Disable header maps so CocoaPods' .hmap files cannot shadow the -I
        # search paths below (a stale/mispointed hmap entry makes clang report
        # "file not found" even when a valid -I path exists).
        build_config.build_settings['USE_HEADERMAP'] = 'NO'
        # Firebase/Google pods ship guard-less public headers (FIROptions.h
        # etc.). Under use_frameworks! the same file is loaded twice - once from
        # the built framework's Headers copy (via module/umbrella import) and
        # once from the pod source dir (via the -I paths injected below) - which
        # yields "duplicate interface definition". Fix: disable modules so
        # #import resolves headers (not framework modules) and drop the
        # framework Headers copies from HEADER_SEARCH_PATHS so every include
        # resolves to the single source copy.
        if target.name.start_with?('Firebase', 'Google', 'RNFB')
          build_config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
          hsp = build_config.build_settings['HEADER_SEARCH_PATHS']
          if hsp
            hsp_clean = hsp.split(' ').reject { |p| p.include?('.framework/Headers') }.join(' ')
            build_config.build_settings['HEADER_SEARCH_PATHS'] = hsp_clean
          end
          # @import requires modules; rewrite it to plain header imports so the
          # module-less Firebase/Google pods still compile (FirebaseCoreInternal.h
          # uses @import FirebaseCore; @import GoogleUtilities;).
          pod_root = File.join(Pod::Config.instance.sandbox_root.to_s, target.name)
          if File.directory?(pod_root)
            Dir.glob(File.join(pod_root, '**', '*.{h,m,mm}')).each do |f|
              content = File.read(f)
              new_content = content.gsub(/@import\s+([A-Za-z_][A-Za-z0-9_]*)\s*;/) { "#import <#{$1}/#{$1}.h>" }
              File.write(f, new_content) if new_content != content
            end
          end
          # Prefixed includes like <FirebaseCoreInternal/FirebaseCoreInternal.h>
          # need a CocoaPods-style header farm, which use_frameworks! does not
          # create. Build it ourselves with SYMLINKS (shared inode -> no
          # duplicate-interface risk) and expose the farm root on the search
          # path so <PodName/File.h> resolves to Public/<PodName>/File.h.
          if File.directory?(pod_root)
            farm_root = File.join(Pod::Config.instance.sandbox_root.to_s, 'Headers', 'Public')
            Dir.mkdir_p(farm_root)
            farm_dir = File.join(farm_root, target.name)
            Dir.mkdir_p(farm_dir)
            Dir.glob(File.join(pod_root, '**', '*.h')).each do |f|
              link = File.join(farm_dir, File.basename(f))
              File.symlink(f, link) unless File.exist?(link) || File.symlink?(link)
            end
            cflags = build_config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
            build_config.build_settings['OTHER_CFLAGS'] = "#{cflags} -I\"$(PODS_ROOT)/Headers/Public\""
          end
        end
        # Every pod target: expose its own source root on the clang command line.
        # CocoaPods' automatic header paths are replaced by framework paths under
        # use_frameworks!, so each pod must find its own headers directly.
        unless target.name.start_with?('Pods-')
          pt = pod_target_map[target.name]
          src_root = '$(PODS_TARGET_SRCROOT)'
          paths = " -I\"#{src_root}\""
          if pt
            sp = pt.respond_to?(:podspec) ? pt.podspec : nil
            # header_mappings_dir is where the pod keeps its headers relative
            # to its source root (covers prefixed includes like
            # <FirebaseMessaging/FirebaseMessaging.h>).
            if sp && sp.respond_to?(:header_mappings_dir)
              hmd = sp.header_mappings_dir
              paths = "#{paths} -I\"#{src_root}/#{hmd}\"" if hmd && !hmd.to_s.empty?
            end
            # Walk this pod AND all its transitive dependencies for real header
            # dirs: add the dir of every .h file plus its parent (parents cover
            # prefixed includes like <FirebaseCore/FirebaseCore.h>). Spec
            # readers and file_accessor are unreliable in post_install, so the
            # on-disk layout is the source of truth.
            hdr_targets = [pt]
            hdr_targets += pt.recursive_dependent_targets if pt.respond_to?(:recursive_dependent_targets)
            hdr_targets.each do |ptc|
              pod_root = File.join(Pod::Config.instance.sandbox_root.to_s, ptc.name)
              next unless File.directory?(pod_root)
              Dir.glob(File.join(pod_root, '**', '*.h')).each do |f|
                d = File.dirname(f)
                next if paths.include?("-I\"#{d}\"")
                # Never inject a dir that shadows the C standard library:
                # folly/portability ships lowercase stdio.h/stdlib.h shims that
                # break libc++'s #include_next ("didn't find libc++'s <stdio.h>").
                # Check both the leaf dir and its parent for C-stdlib headers.
                shadow_dirs = %w[stdio.h stdlib.h string.h wchar.h math.h time.h locale.h signal.h]
                next if shadow_dirs.any? { |h| File.exist?(File.join(d, h)) }
                paths = "#{paths} -I\"#{d}\""
                parent = File.dirname(d)
                unless paths.include?("-I\"#{parent}\"") || shadow_dirs.any? { |h| File.exist?(File.join(parent, h)) }
                  paths = "#{paths} -I\"#{parent}\""
                end
              end
            end
            # Symlink farm paths as a fallback for pods that do create one.
            if sp && sp.respond_to?(:header_dir)
              hd = sp.header_dir
              hd = nil if hd == '.'
              farm_sub = hd && !hd.to_s.empty? ? "#{target.name}/#{hd}" : target.name
              paths = "#{paths} -I\"$(PODS_ROOT)/Headers/Public/#{farm_sub}\" -I\"$(PODS_ROOT)/Headers/Private/#{farm_sub}\""
            end
          end
          # Debug: show what header dirs we derived for the currently failing set
          # (printed into the pod install log on Codemagic).
          if %w[PromisesObjC nanopb FirebaseCore FirebaseMessaging GoogleToolboxForMac hermes-engine].include?(target.name)
            pod_root = File.join(Pod::Config.instance.sandbox_root.to_s, target.name)
            h_count = File.directory?(pod_root) ? Dir.glob(File.join(pod_root, '**', '*.h')).length : -1
            Pod::UI.puts("[berucoffee] #{target.name} pod_root=#{pod_root} exists=#{File.directory?(pod_root)} headers=#{h_count}")
            Pod::UI.puts("[berucoffee] #{target.name} final paths: #{paths}")
          end
          flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{flags}#{paths}"
          cflags = build_config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
          build_config.build_settings['OTHER_CFLAGS'] = "#{cflags}#{paths}"
        end
        if (target.name.start_with?('React-') || target.name == 'ReactCommon' ||
            target.name == 'RNReanimated' || target.name == 'RNWorklets') && !target.name.include?('prebuilt')
          hsp = build_config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
          abs_paths = [
            "#{rn_abs}/React/DevSupport",
            "#{rn_abs}/React/Inspector",
            "#{rn_abs}/React",
            "#{rn_abs}/ReactCommon",
            "#{rn_abs}/ReactCommon/react/nativemodule/core",
            "#{rn_abs}/ReactCommon/callinvoker",
            "#{rn_abs}/ReactCommon/runtime",
            "#{rn_abs}/ReactCommon/jsitooling",
            "$(PODS_TARGET_SRCROOT)/../../..",
            File.join(sandbox_abs, 'glog'),
            File.join(sandbox_abs, 'boost'),
            File.join(sandbox_abs, 'DoubleConversion'),
            File.join(sandbox_abs, 'fast_float', 'include'),
            File.join(sandbox_abs, 'fmt', 'include'),
            File.join(sandbox_abs, 'SocketRocket'),
            File.join(sandbox_abs, 'RCT-Folly'),
            File.join(sandbox_abs, 'Headers', 'Public', 'ReactCommon'),
          ]
          quoted = abs_paths.map { |p| "\"#{p}\"" }.join(' ')
          hsp = "#{quoted} #{hsp}"
          build_config.build_settings['HEADER_SEARCH_PATHS'] = hsp
          # Belt and suspenders: put the same paths directly on the clang
          # command line via OTHER_CPLUSPLUSFLAGS so no build-setting override
          # can strip them before the compiler runs.
          flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
          flags = "#{flags} #{abs_paths.map { |p| "-I\"#{p}\"" }.join(' ')}"
          build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags
        end

        if target.name.start_with?('RNFB')
          defs = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
          defs = [defs] unless defs.is_a?(Array)
          defs << 'RCT_REMOVE_LEGACY_ARCH=0' unless defs.include?('RCT_REMOVE_LEGACY_ARCH=0')
          build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++20'
        end
      end
    end

    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_version
        end
      end
    end
  end
end
